{
  "version": 1,
  "notes": "Config for assets/js/cupboard-figure.js. Units are centimetres. Cube-local coordinates: x from the cube's left inner wall, y from the front opening (back = 39), z from the cube floor. See FIGURE_NOTES.md.",

  "labels": {
    "fig": "Fig 1",
    "title": "The cupboard · live",
    "hint": "Hover or tap a cube",
    "caption": "IKEA Expedit 2×4, drawn from photos. Climate-zone readings, fogger, fan and Sea Monkey bubbler are read live from the public ThingSpeak channel 3372054 (read-only). The four LED panels follow their own 12:00–22:30 timer (UK time); they are not in ThingSpeak.",
    "emptyCube": "Hover or tap a cube to see who lives there.",
    "back": "Whole cupboard",
    "zoomHint": "Esc or ← to go back"
  },

  "camera": { "azimuth": -7, "elevation": 8 },

  "cupboard": {
    "width": 79, "height": 149, "depth": 39,
    "outerBoard": 4.5, "innerBoard": 2.5,
    "finish": "#2b211d"
  },

  "fog": {
    "cube": "cube-r3-r",
    "fogger": "part-fogger",
    "fan": "part-fan",
    "shelf": "part-glass-shelf-climate",
    "output": "fogger",
    "fanOutput": "fan",
    "attackSeconds": 3,
    "lingerSeconds": 5,
    "colour": "#cbb8ff",
    "quality": 0.75
  },

  "simulation": {
    "notes": "24 h simulation. Speeds are simulated seconds per real second: fast ≈ 1 h every 3 s, slow ≈ 2 min every second.",
    "fast": 1200,
    "slow": 120,
    "fixed": 600,
    "leadSeconds": 30,
    "leadReal": 1.2,
    "holdSeconds": 60,
    "bubblerHoldSeconds": 300,
    "startAt": "22:00",
    "oledSecondsPerScreen": 3
  },

  "ledTimer": { "timeZone": "Europe/London", "on": "12:00", "off": "22:30", "label": "LED panels" },

  "thingspeak": {
    "url": "https://api.thingspeak.com/channels/3372054/feeds/last.json",
    "channel": 3372054,
    "pollSeconds": 25,
    "staleAfterSeconds": 120,
    "timeoutSeconds": 10,
    "readings": [
      { "key": "temperature", "field": "field1", "label": "Temperature", "unit": "°C", "decimals": 1 },
      { "key": "humidity", "field": "field2", "label": "Humidity", "unit": "%", "decimals": 0, "warnAbove": 75, "dangerAbove": 89 }
    ],
    "outputs": [
      { "key": "fogger", "field": "field3", "label": "Fogger", "part": "part-fogger", "effect": "mist", "gpio": "D1 / GPIO5" },
      { "key": "fan", "field": "field4", "label": "Fan", "part": "part-fan", "effect": "spin", "gpio": "D3 / GPIO0" },
      { "key": "bubbler", "field": "field5", "label": "Bubbler", "part": "part-seamonkey-tank", "effect": "bubbles", "gpio": "D2 / GPIO4", "note": "Firmware still calls this output \"Light\"." }
    ]
  },

  "oled": {
    "part": "part-oled",
    "secondsPerScreen": 10,
    "screens": [
      { "title": "CLOCK", "show": "clock" },
      { "title": "HUMIDITY", "show": "reading", "key": "humidity" },
      { "title": "TEMP", "show": "reading", "key": "temperature" },
      { "title": "FOGGER", "show": "output", "key": "fogger" },
      { "title": "LIGHT", "show": "output", "key": "bubbler" },
      { "title": "FAN", "show": "output", "key": "fan" }
    ]
  },

  "cubes": [
    {
